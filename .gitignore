# virtual environment
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# CS2 demo files (huge, no reason to commit)
# *.dem alone does NOT match .dem.zst / .dem.gz — the exact forms the downloader handles
*.dem
*.dem.zst
*.dem.gz
demos/
data/_tmp_demos/

# generated artefacts
# Ignore the data directory wholesale. Pattern-matching individual names kept missing
# variants — data/backup.db, data/crosshair.db.old, sqlite sidecars — and each of
# those is GBs of real player nicknames and Steam IDs headed for a public repo.
# Anchored to the repo root: the unanchored `data/` also swallowed the source package
# `engine/data/` (found by the 2026-10-19 audit, CRIT-01).
/data/
*.lgb

# secrets
# `.env` and `*.env` both require the name to END in .env, so .env.local and
# .env.backup were committable. Prefix-match instead, then re-include the template.
.env*
!.env.example
# a dotless `env` at the root is a one-keystroke typo for `.env`; `.env*` does not match it
/env

# run logs — contain player nicknames, match ids and demo URLs
*.log

# macOS
.DS_Store

# editor
.vscode/
.idea/

# Claude Code — settings hold machine-specific paths, but skills are shared work
.claude/*
!.claude/skills/
.venv-old311/
