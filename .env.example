# FACEIT Data API key (developers.faceit.com).
# Used by both the Playwright scraper (player discovery) and the API downloader.
# For `scrape --source api`, this key must ALSO be granted Downloads access.
FACEIT_API_KEY=your_faceit_data_api_key

# Only used by the Playwright path (first-launch Chrome login to Faceit).
FACEIT_EMAIL=you@example.com
FACEIT_PASSWORD=your_faceit_password
